[Unit]
Description=opencode shared server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ntfy settings for the plugins/ntfy TUI plugin. The service password is owned
# by the managed service in ~/.config/opencode/service.json; install.sh
# provisions port 15001 and hostname 0.0.0.0 there. serve --service reads all
# three, so no flags belong here.
EnvironmentFile=-%h/Projects/dotfiles/shell/shared/opencode.env
# V2 is not in the mise/aqua registry (that only tracks the v1 zip releases), so
# this must not use a mise shim. Resolve the first opencode v2 binary present:
# AUR `opencode-beta` installs /usr/bin/opencode; the curl installer writes
# ~/.opencode/bin/opencode. No PATH dependency.
# All interfaces, so tailnet clients reach http://<magicdns>:15001 directly.
# Never map 15001 with `tailscale serve`; it contends with this bind for the
# node's port. The LAN also reaches this port; the service password gates it.
ExecStart=/bin/sh -c 'for p in "$HOME/.opencode/bin/opencode" /usr/bin/opencode "$HOME/.local/bin/opencode"; do [ -x "$p" ] && exec "$p" serve --service; done; echo "opencode v2 not found; install with the curl installer or AUR opencode-beta" >&2; exit 1'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
