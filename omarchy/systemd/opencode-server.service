[Unit]
Description=opencode shared server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/opencode/opencode.env
Environment=OPENCODE_CONFIG=%h/Projects/dotfiles/.config/opencode/opencode.linux.json
ExecStart=%h/.local/share/mise/shims/opencode serve --port 15001 --hostname 0.0.0.0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
