#!/bin/bash
# Locate the Pen/Pencil MCP server binary and exec it with opencode args.
# Works on Linux (Omarchy) and macOS.
#
# Preferred source is @pen.dev/cli installed globally with pnpm: its `pen` shim
# in $PNPM_HOME/bin carries a `# cmd-shim-target=` comment naming the exact
# dist/index.mjs, and the MCP binary sits beside it at dist/out/.
# Falls back to a glob of the global install dirs, then to the desktop app.
set -euo pipefail

# pnpm's global bin dir differs by OS: XDG data dir on Linux, ~/Library on macOS.
if [[ -z "${PNPM_HOME:-}" ]]; then
  if [[ "$(uname -s)" == "Darwin" ]]; then
    PNPM_HOME="$HOME/Library/pnpm"
  else
    PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
  fi
fi

# The platform-specific MCP server binary inside @pen.dev/cli/dist/out/.
mcp_binary_name() {
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) echo "mcp-server-darwin-arm64" ;;
    Darwin-x86_64) echo "mcp-server-darwin-x64" ;;
    Linux-x86_64) echo "mcp-server-linux-x64" ;;
    Linux-aarch64) echo "mcp-server-linux-arm64" ;;
    *) echo "mcp-server" ;;
  esac
}

resolve_cli_mcp() {
  local name shim target candidate
  name="$(mcp_binary_name)"
  shim="$PNPM_HOME/bin/pen"
  if [ -r "$shim" ]; then
    target="$(sed -n 's/^# cmd-shim-target=//p' "$shim" | tail -1)"
    case "$target" in
      */@pen.dev/cli/dist/index.mjs)
        printf '%s\n' "${target%index.mjs}out/$name"
        return 0
        ;;
    esac
  fi
  for candidate in \
    "$PNPM_HOME"/global/v11/*/node_modules/@pen.dev/cli/dist/out/"$name" \
    "$PNPM_HOME"/global/*/node_modules/@pen.dev/cli/dist/out/"$name"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

binary="$(resolve_cli_mcp || true)"

if [ -z "$binary" ]; then
  name="$(mcp_binary_name)"
  for candidate in \
    /Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/"$name" \
    "$HOME/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/$name" \
    /tmp/.mount_pen*/resources/app.asar.unpacked/out/"$name" \
    /opt/Pen/resources/app.asar.unpacked/out/"$name" \
    "$HOME/.local/opt/pen/resources/app.asar.unpacked/out/$name" \
    "$HOME/.local/share/pen/resources/app.asar.unpacked/out/$name"; do
    for f in $candidate; do
      if [ -x "$f" ]; then
        binary="$f"
        break 2
      fi
    done
  done
fi

if [ -z "$binary" ]; then
  echo "pen-mcp: no MCP server binary found." >&2
  echo "pen-mcp: install it with 'pnpm add -g @pen.dev/cli', or launch the Pen desktop app." >&2
  exit 1
fi

exec "$binary" "$@"
