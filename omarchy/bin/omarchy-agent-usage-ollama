#!/bin/bash

# omarchy:summary=Print the Ollama Cloud usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
#
# Reads Ollama Cloud quota from the undocumented endpoint the dashboard
# itself calls: GET https://ollama.com/api/usage with a Bearer API key.
# The response carries `limits.<window>.usage` as a 0..1 fraction of the
# plan allowance, plus per-model request counts. There are no exact reset
# timestamps, so `resetsAt` stays empty rather than guessed.
#
# Output is one display-ready record matching the contract in
# omarchy-agent-usage-update, so the omarchy.agents panel picks it up as a
# tab. The record is also cached: a failed probe re-emits the last good one
# so the panel does not blink empty on a transient network error.
#
# Key resolution: OLLAMA_API_KEY first, then the file opencode already uses
# at ~/.local/share/opencode/secrets/ollama_api_key.

set -euo pipefail

ENDPOINT="https://ollama.com/api/usage"
AGENT_ID="ollama"
AGENT_NAME="Ollama Cloud"
AUTH_HELP="Set OLLAMA_API_KEY or write the key to ~/.local/share/opencode/secrets/ollama_api_key."

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/agent-usage"
CACHE_FILE="$CACHE_DIR/ollama.json"
KEY_FILE="$HOME/.local/share/opencode/secrets/ollama_api_key"

limits_only=0
for arg in "$@"; do
  case "$arg" in
    --limits-only) limits_only=1 ;;
    --force) : ;;
  esac
done

resolve_key() {
  if [[ -n ${OLLAMA_API_KEY:-} ]]; then
    printf '%s' "$OLLAMA_API_KEY"
    return 0
  fi
  if [[ -s $KEY_FILE ]]; then
    tr -d '[:space:]' <"$KEY_FILE"
    return 0
  fi
  return 1
}

# Human window title from the API's key: session -> Session (5-hour), etc.
# The panel also derives a title from the label, but naming the window here
# keeps a monthly plan from rendering as a generic "Limit".
window_title() {
  case "${1,,}" in
    session) echo "Session (5-hour)" ;;
    weekly) echo "Weekly (7-day)" ;;
    monthly) echo "Monthly" ;;
    daily) echo "Daily" ;;
    *) echo "${1^}" ;;
  esac
}

# The API reports usage as a 0..1 fraction. A value above 1 means the payload
# switched to a percent scale, so divide it down.
normalize_percent() {
  jq -n --argjson v "$1" '
    if $v == null then empty
    elif ($v | type) != "number" then empty
    elif $v > 1 then (($v / 100) | if . > 1 then 1 else . end)
    else ($v | if . < 0 then 0 else . end)
    end'
}

build_record() {
  local payload="$1" updated_at="$2"
  local limits_json="[]"

  # One entry per window the account returns. usage -> percent (0..1).
  while IFS= read -r key; do
    [[ -n $key ]] || continue
    local raw title percent
    raw="$(jq -r --arg k "$key" '.limits[$k].usage // empty' <<<"$payload")"
    [[ -n $raw ]] || continue
    percent="$(normalize_percent "$raw")" || continue
    [[ -n $percent ]] || continue
    title="$(window_title "$key")"
    limits_json="$(jq -c \
      --arg label "$title" \
      --argjson percent "$percent" \
      '. + [{label: $label, title: $label, percent: $percent, resetsAt: ""}]' <<<"$limits_json")"
  done < <(jq -r '(.limits // {}) | keys[]' <<<"$payload")

  # Request counts across windows, summed per model. These are requests, not
  # tokens, so they ride along as an extra field rather than faking the
  # token buckets the panel charts.
  local requests_json
  requests_json="$(jq -c '
    [ (.limits // {}) | to_entries[] | (.value.models // [])[] ]
    | group_by(.name)
    | map({key: .[0].name, value: (map(.request_count // 0) | add)})
    | from_entries' <<<"$payload")"

  local total_requests
  total_requests="$(jq '[.[]] | add // 0' <<<"$requests_json")"

  jq -nc \
    --arg id "$AGENT_ID" \
    --arg name "$AGENT_NAME" \
    --arg updated_at "$updated_at" \
    --arg auth_help "$AUTH_HELP" \
    --argjson limits "$limits_json" \
    --argjson requests "$requests_json" \
    --argjson total_requests "$total_requests" \
    '{
      schemaVersion: 1,
      id: $id,
      name: $name,
      updatedAt: $updated_at,
      ready: true,
      hasLocalStats: false,
      hasPromptStats: false,
      todayPrompts: 0,
      todaySessions: 0,
      todayTotalTokens: 0,
      todayTokensByModel: {},
      recentDays: [],
      totalPrompts: 0,
      totalSessions: 0,
      activeDays: 0,
      activeDates: [],
      modelUsage: {},
      limits: $limits,
      tierLabel: "",
      usageStatusText: (if $total_requests > 0 then ($total_requests | tostring) + " requests this period" else "" end),
      authHelpText: $auth_help,
      requestCountsByModel: $requests
    }'
}

emit_cached() {
  if [[ -s $CACHE_FILE ]]; then
    cat "$CACHE_FILE"
  else
    jq -nc \
      --arg id "$AGENT_ID" --arg name "$AGENT_NAME" --arg auth_help "$AUTH_HELP" \
      '{schemaVersion:1,id:$id,name:$name,updatedAt:"",ready:false,hasLocalStats:false,
        hasPromptStats:false,todayPrompts:0,todaySessions:0,todayTotalTokens:0,
        todayTokensByModel:{},recentDays:[],totalPrompts:0,totalSessions:0,activeDays:0,
        activeDates:[],modelUsage:{},limits:[],tierLabel:"",usageStatusText:"",
        authHelpText:$auth_help}'
  fi
}

main() {
  local key
  if ! key="$(resolve_key)"; then
    emit_cached
    exit 0
  fi

  local response http_code body
  response="$(curl -sS -m 15 -w '\n%{http_code}' \
    -H "Authorization: Bearer $key" \
    -H "Accept: application/json" \
    "$ENDPOINT" 2>/dev/null)" || { emit_cached; exit 0; }

  http_code="${response##*$'\n'}"
  body="${response%$'\n'*}"

  if [[ $http_code != "200" ]] || ! jq -e . >/dev/null 2>&1 <<<"$body"; then
    emit_cached
    exit 0
  fi

  local record
  record="$(build_record "$body" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)")" || { emit_cached; exit 0; }

  if (( ! limits_only )); then
    mkdir -p "$CACHE_DIR"
    local tmp="$CACHE_FILE.$$"
    printf '%s\n' "$record" >"$tmp" && mv -f "$tmp" "$CACHE_FILE"
  fi
  printf '%s\n' "$record"
}

main
