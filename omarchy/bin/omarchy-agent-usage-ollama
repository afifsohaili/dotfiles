#!/bin/bash

# omarchy:summary=Print the Ollama Cloud usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
#
# Ollama replaced the percent quota windows that GET /api/usage used to
# return (`limits.<window>.usage`) with metered usage over 24h, 7d, or 30d:
# `usage_usd`, `request_count`, and token totals per bucket. No
# key-accessible endpoint reports the old session/weekly percentages anymore,
# so the record charts tokens per day from the 7d range and rides the dollar
# figure on the status line the panel shows under the tool name.
#
# Output is one display-ready record matching the contract in
# omarchy-agent-usage-update, so the omarchy.agents panel picks it up as a
# tab. The record is also cached: a failed probe re-emits the last good one
# so the panel does not blink empty on a transient network error. The stats
# are account-global — the API reports the whole account, not this machine —
# so the record declares scope "account" and sync merges take the widest
# value instead of summing the same account twice.
#
# Key resolution: OLLAMA_API_KEY first, then the file opencode already uses
# at ~/.local/share/opencode/secrets/ollama_api_key.

set -euo pipefail

ENDPOINT="https://ollama.com/api/usage?range=7d"
AGENT_ID="ollama"
AGENT_NAME="Ollama Cloud"
AUTH_HELP="Set OLLAMA_API_KEY or write the key to ~/.local/share/opencode/secrets/ollama_api_key."
USAGE_HELP="Ollama bills usage in dollars now; the API no longer reports percent limits. Figures from ollama.com/api/usage."

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/agent-usage"
CACHE_FILE="$CACHE_DIR/ollama.json"
KEY_FILE="$HOME/.local/share/opencode/secrets/ollama_api_key"

limits_only=0
for arg in "$@"; do
  case "$arg" in
    --limits-only) limits_only=1 ;;
    --force) : ;;
  esac
done

resolve_key() {
  if [[ -n ${OLLAMA_API_KEY:-} ]]; then
    printf '%s' "$OLLAMA_API_KEY"
    return 0
  fi
  if [[ -s $KEY_FILE ]]; then
    tr -d '[:space:]' <"$KEY_FILE"
    return 0
  fi
  return 1
}

# The last 7 local dates, oldest first — the panel's "tokens by day" rows.
# Bucket dates are UTC; for the +08 machines these sync between, a UTC date
# is already the right local day, so the date prefix is compared as-is.
recent_dates() {
  local i
  for (( i = 6; i >= 0; i-- )); do
    date -d "today - $i days" +%F
  done
}

build_record() {
  local payload="$1" updated_at="$2"
  local days_json usd requests usage_text
  days_json="$(recent_dates | jq -Rsc 'split("\n")[:-1]')"
  usd="$(jq -r '.totals.usage_usd // 0' <<<"$payload")"
  requests="$(jq -r '.totals.request_count // 0' <<<"$payload")"
  usage_text="$(awk -v u="$usd" -v r="$requests" 'BEGIN { printf "$%.2f · %d requests (7d)", u, r }')"

  jq -c \
    --arg id "$AGENT_ID" \
    --arg name "$AGENT_NAME" \
    --arg updated_at "$updated_at" \
    --arg auth_help "$USAGE_HELP" \
    --arg usage_text "$usage_text" \
    --argjson days "$days_json" \
    '
    def bucket_date: (.from // "")[0:10];
    def tokens: ((.input_tokens // 0) + (.output_tokens // 0));
    . as $root |
    ($root.buckets // []) as $buckets |
    [ $days[] as $d |
      { date: $d,
        messageCount: ([$buckets[] | select(bucket_date == $d) | tokens] | add // 0) }
    ] as $recent |
    ($recent | map(select(.messageCount > 0)) | map(.date)) as $active |
    {
      schemaVersion: 1,
      id: $id,
      name: $name,
      updatedAt: $updated_at,
      ready: true,
      hasLocalStats: false,
      hasPromptStats: false,
      scope: "account",
      todayPrompts: 0,
      todaySessions: 0,
      todayTotalTokens: ($recent | last | .messageCount // 0),
      todayTokensByModel: {},
      recentDays: $recent,
      totalPrompts: (($root.totals.request_count) // 0),
      totalSessions: 0,
      activeDays: ($active | length),
      activeDates: $active,
      modelUsage: {},
      limits: [],
      tierLabel: "",
      usageStatusText: $usage_text,
      authHelpText: $auth_help
    }' <<<"$payload"
}

emit_cached() {
  if [[ -s $CACHE_FILE ]]; then
    cat "$CACHE_FILE"
  else
    jq -nc \
      --arg id "$AGENT_ID" --arg name "$AGENT_NAME" --arg auth_help "$AUTH_HELP" \
      '{schemaVersion:1,id:$id,name:$name,updatedAt:"",ready:false,hasLocalStats:false,
        hasPromptStats:false,scope:"account",todayPrompts:0,todaySessions:0,todayTotalTokens:0,
        todayTokensByModel:{},recentDays:[],totalPrompts:0,totalSessions:0,activeDays:0,
        activeDates:[],modelUsage:{},limits:[],tierLabel:"",
        usageStatusText:"Ollama usage unavailable",
        authHelpText:$auth_help}'
  fi
}

main() {
  local key
  if ! key="$(resolve_key)"; then
    emit_cached
    exit 0
  fi

  local response http_code body
  response="$(curl -sS -m 15 -w '\n%{http_code}' \
    -H "Authorization: Bearer $key" \
    -H "Accept: application/json" \
    "$ENDPOINT" 2>/dev/null)" || { emit_cached; exit 0; }

  http_code="${response##*$'\n'}"
  body="${response%$'\n'*}"

  if [[ $http_code != "200" ]] || ! jq -e . >/dev/null 2>&1 <<<"$body"; then
    emit_cached
    exit 0
  fi

  local record
  record="$(build_record "$body" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)")" || { emit_cached; exit 0; }

  if (( ! limits_only )); then
    mkdir -p "$CACHE_DIR"
    local tmp="$CACHE_FILE.$$"
    printf '%s\n' "$record" >"$tmp" && mv -f "$tmp" "$CACHE_FILE"
  fi
  printf '%s\n' "$record"
}

main
