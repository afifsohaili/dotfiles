#!/bin/bash

# oc-project: choose a directory and open the shared opencode TUI on it.
#
# `oc-project list` is the row builder. It emits one menu row per directory,
# in the exact format `omarchy-menu-select` expects:
#
#     <TAB><basename><TAB><abs path>
#
# The leading icon column is empty and the absolute path is the stable key.
# Rows come from two sources, deduped by canonical path, source 1 first:
#
#   1. opencode's sqlite DB `project_directory` joined to `project` and
#      ordered by `project.time_updated` descending (most recent first).
#   2. directories one level deep under the projects root, sorted.
#
# Nonexistent paths and hidden dirs are dropped. Every optional input is
# tolerated: a missing sqlite3, DB, table, or projects dir yields whatever
# rows remain, never an error.
#
# `oc-project pick` (the default when no subcommand is given) builds the same
# rows, prepends an empty-icon `Other…` row, and hands them to the menu.
#
#     <TAB>Other…<TAB>
#
# The menu returns `<basename><TAB><abs path>` for a directory row, or the
# `Other…` row itself; the latter chains to `omarchy-menu-input` for a typed
# path. The resolved canonical directory is printed, nothing else. Launching
# opencode is a later phase.
#
# `oc-project focus <dir>` reports whether an opencode window is already open
# on <dir>. It walks the Hyprland client list, keeps only
# `org.omarchy.opencode` windows, follows each window's terminal pid to its
# opencode child, and matches the child's `--dir` argument against <dir>
# (both canonicalised). On a match it focuses the window and prints its
# address; on no match it exits with the distinct status 3 and prints
# nothing, so a caller can tell "already open" from "launch a new one".
# It never launches anything. Missing jq, malformed JSON, and unreadable or
# absent /proc entries are all tolerated as a no-match.
#
# `oc-project open <dir>` launches opencode on the canonical <dir>. The window
# gets class `org.omarchy.opencode` and title `oc: <dir>`. The launcher is the
# full argv built here and run through the OC_PROJECT_LAUNCH seam:
#
#     <launcher> --app-id=org.omarchy.opencode --title=oc: <dir> oc <dir>
#
# The default launch mirrors the binding it replaced:
#
#     setsid uwsm-app -- xdg-terminal-exec \
#         --app-id=org.omarchy.opencode --title=oc: <dir> oc <dir>
#
# `setsid uwsm-app --` puts the terminal in a UWSM/systemd app scope, as the
# old binding did. `xdg-terminal-exec` is called directly rather than through
# `omarchy-launch-tui` because the latter only parses `--app-id=` and
# hardcodes `xdg-terminal-exec --app-id=$APP_ID -e "$1" "${@:2}"`, so it cannot
# forward a `--title`. Setting `OC_PROJECT_LAUNCH` replaces the launcher with a
# single command that receives the same four trailing arguments.
#
# `oc-project` with no subcommand is the wired default flow:
#   pick -> focus <dir>; if focus reports EXIT_NOT_FOUND (3), open <dir>;
#   any other non-zero from focus is propagated. Cancel at pick exits non-zero
#   quietly. A focus success means "focused"; nothing is launched.
#
# Exit codes:
#   0  focus found + focused, or open launched, or a successful pick/list
#   1  usage error / failure to focus / invalid directory
#   3  no matching window (open a new one) in `focus`
#
# Testability seams (see omarchy/plans/oc-project.md):
#   OC_PROJECT_OPENCODE_DB   default $HOME/.local/share/opencode/opencode.db
#   OC_PROJECT_PROJECTS_DIR  default $HOME/Projects
#   OC_PROJECT_MENU_SELECT   default omarchy-menu-select
#   OC_PROJECT_MENU_INPUT    default omarchy-menu-input
#   OC_PROJECT_HYPRCTL       default hyprctl
#   OC_PROJECT_PROC_ROOT     default /proc
#   OC_PROJECT_LAUNCH        overrides the launcher command (default is
#                            `setsid uwsm-app -- xdg-terminal-exec`)
#   OC_PROJECT_FOCUS         default (internal focus); overrides focus in the
#                            default flow only, for tests

# omarchy:summary=Pick a directory and open the shared opencode TUI on it
# omarchy:args=[open|pick|list|focus] [dir]
# omarchy:examples=oc-project|oc-project open <dir>|oc-project list|oc-project focus <dir>

set -euo pipefail

OPENCODE_DB="${OC_PROJECT_OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"
PROJECTS_DIR="${OC_PROJECT_PROJECTS_DIR:-$HOME/Projects}"
MENU_SELECT="${OC_PROJECT_MENU_SELECT:-omarchy-menu-select}"
MENU_INPUT="${OC_PROJECT_MENU_INPUT:-omarchy-menu-input}"
HYPRCTL="${OC_PROJECT_HYPRCTL:-hyprctl}"
PROC_ROOT="${OC_PROJECT_PROC_ROOT:-/proc}"
LAUNCH="${OC_PROJECT_LAUNCH:-}"
FOCUS_CMD="${OC_PROJECT_FOCUS:-}"

# Window class set on the launched terminal.
WINDOW_CLASS='org.omarchy.opencode'

# Distinct status for "no opencode window is open on that directory".
EXIT_NOT_FOUND=3

# Sentinel row, in the menu row format: empty glyph column, `Other…` label,
# empty subtext (a directory row always carries a non-empty absolute path).
# The menu strips the glyph column and drops an empty subtext, so the sentinel
# comes back as the bare label. A directory named `Other…` comes back as
# `Other…\t<path>` and is therefore distinguishable.
OTHER_ROW=$'\tOther…\t'
OTHER_SELECTION='Other…'

# ---------------------------------------------------------------- helpers

# canonical <path> -> absolute, symlink-resolved path on stdout.
# Missing paths resolve to the absolute path, which is enough for dedupe.
canonical() {
  local path="$1"
  if [[ $path == /* ]]; then
    readlink -f -- "$path" 2>/dev/null || printf '%s\n' "$path"
  else
    return 1
  fi
}

# emit_row <path> -> one menu row, exactly `<TAB><basename><TAB><path>`.
emit_row() {
  local path="$1" base
  base="$(basename -- "$path")"
  printf '\t%s\t%s\n' "$base" "$path"
}

# ------------------------------------------------------------ db source

# Print canonical DB directory paths, most-recently-updated first.
db_paths() {
  [[ -f $OPENCODE_DB ]] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0

  local rows
  rows="$(sqlite3 -readonly -noheader -separator '|' "$OPENCODE_DB" \
    "SELECT d.directory
       FROM project_directory AS d
       JOIN project AS p ON p.id = d.project_id
      ORDER BY p.time_updated DESC;" 2>/dev/null)" || return 0

  local dir
  while IFS= read -r dir; do
    [[ -n $dir ]] && printf '%s\n' "$dir"
  done <<<"$rows"
  return 0
}

# ------------------------------------------------------- projects source

# Print directories one level deep under PROJECTS_DIR, sorted, no hidden.
projects_paths() {
  [[ -d $PROJECTS_DIR ]] || return 0

  local entry
  for entry in "$PROJECTS_DIR"/*; do
    [[ -d $entry ]] || continue
    printf '%s\n' "$entry"
  done | LC_ALL=C sort
}

# ----------------------------------------------------------------- list

# Print the deduped menu rows. Source 1 (DB) wins a path's position; source
# 2 appends anything not already seen. Paths that do not exist are dropped.
cmd_list() {
  local seen=$'\n' path canon
  local -a ordered=()

  while IFS= read -r path; do
    [[ -n $path ]] || continue
    canon="$(canonical "$path")" || continue
    [[ -d $canon ]] || continue
    [[ $(basename -- "$canon") != .* ]] || continue
    [[ $canon == *$'\n'* ]] && continue
    if [[ $seen == *$'\n'"$canon"$'\n'* ]]; then
      continue
    fi
    seen+="$canon"$'\n'
    ordered+=("$canon")
  done < <(db_paths; projects_paths)

  local p
  if (( ${#ordered[@]} > 0 )); then
    for p in "${ordered[@]}"; do
      emit_row "$p"
    done
  fi
  return 0
}

# -------------------------------------------------------- path resolving

# resolve_input <typed> -> canonical directory on stdout, or 1.
# Expands a leading `~`, resolves relative paths against $PWD, then
# canonicalises. Fails unless the result is an existing directory.
resolve_input() {
  local typed="$1" path canon
  [[ -n $typed ]] || return 1

  case "$typed" in
    "~") path="$HOME" ;;
    "~/"*) path="$HOME/${typed#\~/}" ;;
    /*) path="$typed" ;;
    *) path="$PWD/$typed" ;;
  esac

  canon="$(readlink -f -- "$path" 2>/dev/null)" || return 1
  [[ -d $canon ]] || return 1
  printf '%s\n' "$canon"
}

# notify_error <message> -> best-effort desktop notification; never fatal.
notify_error() {
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send "oc-project" "$1" >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------ pick

# Print the menu rows: the Other… row first, then the list rows.
cmd_pick_rows() {
  printf '%s\n' "$OTHER_ROW"
  cmd_list
}

# cmd_pick -> canonical directory on stdout; 0 on a valid pick.
# Non-zero with no stdout on cancel (quiet) or an invalid path (stderr + notify).
cmd_pick() {
  local selection path

  # A cancel at either menu (non-zero) is propagated quietly: no message,
  # no stdout. The `|| return $?` keeps `set -e` from aborting and preserves
  # the menu's real exit status.
  #
  # Rows are fed through process substitution, not a pipe: under `pipefail` a
  # menu that exits before reading every row would SIGPIPE `cmd_pick_rows` and
  # surface 141 instead of the menu's own status. A redirection contributes no
  # status, so only the menu's exit code survives.
  selection="$("$MENU_SELECT" 'Open opencode in…' < <(cmd_pick_rows))" || return $?

  if [[ $selection == "$OTHER_SELECTION" ]]; then
    path="$("$MENU_INPUT" 'Directory')" || return $?
  else
    path="$(printf '%s' "$selection" | cut -f2)"
  fi

  if ! resolve_input "$path"; then
    echo "oc-project: not a directory: $path" >&2
    notify_error "Not a directory: $path"
    return 1
  fi
}

# ----------------------------------------------------------------- focus

# path_of_dir_arg <argv...> -> the directory argument, if any. Prints the path,
# or nothing when none is present. Prefers the argument after a literal `--dir`
# token (V1 attach form); falls back to any absolute path that exists as a
# directory (V2 form: `opencode --server URL --continue /path/dir`). A path
# containing spaces is not supported, which matches this machine's opencode
# invocations.
path_of_dir_arg() {
  local arg want=0 candidate=""
  for arg in "$@"; do
    if (( want )); then
      printf '%s\n' "$arg"
      return 0
    fi
    if [[ $arg == --dir ]]; then
      want=1
      continue
    fi
    if [[ $arg == /* && -d $arg ]]; then
      candidate=$arg
    fi
  done
  [[ -n $candidate ]] && printf '%s\n' "$candidate"
  return 0
}

# window_address_for_dir <dir> -> address of the first matching window on stdout.
# Empty output when no window matches, jq is missing, the JSON is malformed,
# or any /proc entry is unreadable. Never fails, never crashes.
window_address_for_dir() {
  local dir="$1" clients pid addr child argpath canon kids_file kids
  local -a argv=() child_pids=()

  command -v jq >/dev/null 2>&1 || return 0

  clients="$("$HYPRCTL" clients -j 2>/dev/null)" || return 0
  [[ -n $clients ]] || return 0

  # Iterate over "pid<TAB>address" pairs for the opencode class only. jq
  # filters out null/mistyped fields so we never walk /proc/null or dispatch
  # address:null.
  while IFS=$'\t' read -r pid addr; do
    [[ -n $pid && -n $addr ]] || continue

    # /proc/<pid>/task/<pid>/children is space-separated pids on one line,
    # with a trailing space and NO trailing newline. `read` per line returns
    # non-zero at that EOF and skips the body, so read the whole file and
    # split on whitespace instead.
    kids_file="$PROC_ROOT/$pid/task/$pid/children"
    [[ -r $kids_file ]] || continue
    # `$(< file)` alone is a bash fast-path, but adding a redirection to it
    # turns the whole thing into a redirection-only command with empty output,
    # so read through cat here.
    kids="$(cat "$kids_file" 2>/dev/null)" || continue
    # shellcheck disable=SC2206 # word-splitting is the point (space-separated)
    child_pids=($kids)

    for child in "${child_pids[@]}"; do
      [[ $child =~ ^[0-9]+$ ]] || continue
      [[ -r "$PROC_ROOT/$child/cmdline" ]] || continue

      argv=()
      while IFS= read -r -d '' arg; do
        argv+=("$arg")
      done <"$PROC_ROOT/$child/cmdline" 2>/dev/null || continue
      (( ${#argv[@]} > 0 )) || continue

      argpath="$(path_of_dir_arg "${argv[@]}")"
      [[ -n $argpath ]] || continue

      canon="$(readlink -f -- "$argpath" 2>/dev/null)" || continue
      if [[ $canon == "$dir" ]]; then
        printf '%s\n' "$addr"
        return 0
      fi
    done
  done < <(printf '%s' "$clients" | jq -r --arg class "$WINDOW_CLASS" \
    '.[]? | select(.class == $class)
          | select((.pid | type) == "number")
          | select((.address | type) == "string" and (.address | length) > 0)
          | "\(.pid)\t\(.address)"' 2>/dev/null)
  return 0
}

# cmd_focus <dir> -> focus a window already open on <dir>.
# 0 with the address on stdout on a match; EXIT_NOT_FOUND, quiet, otherwise.
cmd_focus() {
  local dir="$1" canon addr
  canon="$(readlink -f -- "$dir" 2>/dev/null)" || return "$EXIT_NOT_FOUND"

  addr="$(window_address_for_dir "$canon")"
  [[ -n $addr ]] || return "$EXIT_NOT_FOUND"

  if ! "$HYPRCTL" dispatch 'hl.dsp.focus({ window = "address:'"$addr"'" })' \
      >/dev/null 2>&1; then
    "$HYPRCTL" dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
  fi

  printf '%s\n' "$addr"
  return 0
}

# ------------------------------------------------------------------ open

# cmd_open <dir> -> launch opencode on the canonical <dir>.
# Exits 1 with a message on stderr (and a best-effort notification) when
# <dir> is not a directory; otherwise builds and runs the launcher argv and
# returns its status.
#
# The default launch mirrors the binding this replaced: `setsid uwsm-app --`
# so the terminal lands in a UWSM/systemd app scope (app tracking, slice
# assignment, double-launch avoidance). `omarchy-launch-tui` cannot carry the
# `--title`, so the argv is built here instead of going through it.
cmd_open() {
  local dir="$1" canon
  if [[ -n $dir ]]; then
    canon="$(readlink -f -- "$dir" 2>/dev/null)" || canon=""
  fi
  if [[ -z ${canon:-} || ! -d $canon ]]; then
    echo "oc-project: not a directory: $dir" >&2
    notify_error "Not a directory: $dir"
    return 1
  fi

  local -a argv=("--app-id=$WINDOW_CLASS" "--title=oc: $canon" oc "$canon")
  if [[ -n $LAUNCH ]]; then
    "$LAUNCH" "${argv[@]}"
  else
    setsid uwsm-app -- xdg-terminal-exec "${argv[@]}"
  fi
}

# cmd_focus_seam <dir> -> run the focus step of the default flow.
# Uses OC_PROJECT_FOCUS as a seam when set (tests), otherwise the internal
# cmd_focus. stdout/stderr and the exit status are passed through unchanged.
cmd_focus_seam() {
  if [[ -n $FOCUS_CMD ]]; then
    "$FOCUS_CMD" "$@"
  else
    cmd_focus "$@"
  fi
}

# cmd_default -> the wired no-subcommand flow: pick -> focus -> open.
# focus 0 means "focused": nothing is launched. focus EXIT_NOT_FOUND (3)
# means "not open": launch. Any other non-zero from focus propagates. A
# cancel or invalid pick exits non-zero quietly with no launch.
cmd_default() {
  local dir status
  dir="$(cmd_pick)" || return $?
  if cmd_focus_seam "$dir" >/dev/null 2>&1; then
    return 0
  else
    status=$?
  fi
  (( status == EXIT_NOT_FOUND )) || return "$status"
  cmd_open "$dir"
}

# ----------------------------------------------------------------- main

main() {
  # True "no subcommand" (zero arguments) is the wired default flow. An
  # explicit empty argument (`oc-project ""`) is treated as `pick`, which is
  # how the Phase 2 tests exercise the old default.
  if (( $# == 0 )); then
    cmd_default
    return
  fi

  local cmd="$1"
  case "$cmd" in
    "")
      cmd_pick ;;
    pick) cmd_pick ;;
    list) cmd_list ;;
    focus)
      local dir="${2:-}"
      if [[ -z $dir ]]; then
        echo "oc-project: focus needs a directory" >&2
        exit 1
      fi
      cmd_focus "$dir"
      ;;
    open)
      cmd_open "${2:-}"
      ;;
    *)
      echo "oc-project: unknown command: $cmd" >&2
      exit 1
      ;;
  esac
}

main "$@"
