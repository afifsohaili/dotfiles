{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // Restart the shared opencode server (reloads config, plugins, MCP servers).
  "update.process.opencode": {
    "icon": "󰚩",
    "label": "Opencode Server",
    "action": "systemctl --user restart opencode-server.service && omarchy-notification-send -g 󰚩 'Opencode' 'Server restarted'"
  },

  // Caffeinate: keep the machine awake for a chosen duration. Presets are
  // one click; Custom opens the same typed-duration prompt the bar panel
  // uses. Bare numbers are hours (1 = 1h); units m/h/d are accepted.
  "trigger.toggle.caffeinate": {"icon":"󰅶","label":"Caffeinate"},
  "trigger.toggle.caffeinate.30m": {"icon":"󰅶","label":"30 minutes","action":"omarchy-caffeinate start 30m"},
  "trigger.toggle.caffeinate.1h": {"icon":"󰅶","label":"1 hour","action":"omarchy-caffeinate start 1h"},
  "trigger.toggle.caffeinate.2h": {"icon":"󰅶","label":"2 hours","action":"omarchy-caffeinate start 2h"},
  "trigger.toggle.caffeinate.4h": {"icon":"󰅶","label":"4 hours","action":"omarchy-caffeinate start 4h"},
  "trigger.toggle.caffeinate.8h": {"icon":"󰅶","label":"8 hours","action":"omarchy-caffeinate start 8h"},
  "trigger.toggle.caffeinate.12h": {"icon":"󰅶","label":"12 hours","action":"omarchy-caffeinate start 12h"},
  "trigger.toggle.caffeinate.24h": {"icon":"󰅶","label":"24 hours","action":"omarchy-caffeinate start 24h"},
  "trigger.toggle.caffeinate.custom": {"icon":"󰅶","label":"Custom…","action":"omarchy-caffeinate prompt"},
  "trigger.toggle.caffeinate.stop": {"icon":"󰅶","label":"Stop caffeinate","when":"omarchy-caffeinate active","action":"omarchy-caffeinate stop && omarchy-notification-send -g 󰅶 'Caffeinate' 'Stopped'"},

  // Launch the shared-server opencode client from the Defaults > Agent row.
  // Fields are restated because partial overrides normalize empty label/icon
  // and would otherwise clobber the default row's.
  "setup.default.agent.opencode": {
    "icon": "\uE902",
    "iconFont": "omarchy",
    "label": "OpenCode",
    "checked": "[[ \"$(omarchy-default-agent)\" == \"opencode\" ]]",
    "action": "omarchy-launch-tui --app-id=org.omarchy.opencode oc \"$HOME/Projects\""
  }
}
