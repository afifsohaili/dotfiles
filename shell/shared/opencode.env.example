# Template for shell/shared/opencode.env (gitignored).
# Copy to opencode.env and fill in locally. Format is KEY=value (no `export`),
# so the systemd opencode-server.service can read it via EnvironmentFile=.
#
# ntfy.sh topic that notify.ts posts permission/question/session-idle alerts to.
# Unset means ntfy is skipped (desktop notifications still fire).
OPENCODE_NTFY_TOPIC=
# This machine's opencode server URL, used for the notification click-through.
OPENCODE_NTFY_URL=
