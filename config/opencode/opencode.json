{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "projects": {
      "path": "~/Projects",
      "description": "Use for personal projects in ~/Projects"
    },
    "dotfiles": {
      "path": "~/Projects/dotfiles",
      "description": "Use for personal shell, editor, and tool configuration conventions"
    },
    "mise": {
      "path": "~/.config/mise",
      "description": "Use for mise tool version config and task definitions"
    }
  },
  "default_agent": "ollama-dsv4f",
  "websearch": false,
  "agents": {
    "explore": {
      "mode": "subagent",
      "model": "ollama-cloud/deepseek-v4.1-flash"
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/herdr/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/omarchy/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/hypr/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/alacritty/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/foot/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/kitty/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/ghostty/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Tiga/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Work/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Desktop/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/usr/share/omarchy/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/omarchy/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/systemd/user/*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.local", "effect": "deny" },
    { "action": "read", "resource": "*.env.playwright", "effect": "allow" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm ./*", "effect": "allow" },
    { "action": "shell", "resource": "rm /Users/afifsohaili/Tiga/*", "effect": "allow" },
    { "action": "shell", "resource": "rm /Users/afifsohaili/Projects/*", "effect": "allow" },
    { "action": "shell", "resource": "omarchy", "effect": "allow" },
    { "action": "shell", "resource": "omarchy *", "effect": "allow" },
    { "action": "shell", "resource": "hyprctl *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl --user", "effect": "allow" },
    { "action": "shell", "resource": "systemctl --user *", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "pkexec *", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "websearch": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "{env:HOME}/.config/opencode/mcp/ollama/web-search-mcp.py"
        ],
        "environment": {
          "OLLAMA_API_KEY": "{file:~/.local/share/opencode/secrets/ollama_api_key}"
        },
        "disabled": false,
        "codemode": false,
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        }
      },
      "pencil": {
        "type": "local",
        "command": [
          "{env:HOME}/Projects/dotfiles/omarchy/bin/pen-mcp",
          "--app",
          "desktop",
          "--agent",
          "openCodeCLI"
        ],
        "disabled": false
      }
    }
  }
}
