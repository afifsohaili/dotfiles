{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "mode": "subagent",
      "model": "ollama-cloud/deepseek-v4.1-flash",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "general": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "default_agent": "ollama-dsv4f",
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "permission",
        "effect": "deny",
        "resource": "read:*secrets.sh"
      },
      {
        "action": "permission",
        "effect": "deny",
        "resource": "read:*opencode.env"
      },
      {
        "action": "permission",
        "effect": "deny",
        "resource": "read:*opencode/secrets/*"
      },
      {
        "action": "permission",
        "effect": "deny",
        "resource": "shell:*secrets.sh*"
      },
      {
        "action": "permission",
        "effect": "deny",
        "resource": "shell:*opencode.env*"
      }
    ]
  },
  "mcp": {
    "servers": {
      "pencil": {
        "command": [
          "{env:HOME}/Projects/dotfiles/omarchy/bin/pen-mcp",
          "--app",
          "desktop",
          "--agent",
          "openCodeCLI"
        ],
        "disabled": false,
        "type": "local"
      },
      "websearch": {
        "codemode": false,
        "command": [
          "uv",
          "run",
          "{env:HOME}/.config/opencode/mcp/ollama/web-search-mcp.py"
        ],
        "disabled": false,
        "environment": {
          "OLLAMA_API_KEY": "{file:~/.local/share/opencode/secrets/ollama_api_key}"
        },
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        },
        "type": "local"
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/opencode/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/herdr/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/omarchy/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/hypr/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/alacritty/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/foot/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/kitty/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/ghostty/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.opencode/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.agents"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.agents/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Tiga/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Work/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Desktop/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/usr/share/omarchy/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.local/share/omarchy/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/systemd/user/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/opencode"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/mise"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/mise/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/herdr"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/omarchy"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/hypr"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/alacritty"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/foot"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/kitty"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/ghostty"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Projects"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Projects/*"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/Work"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env.*"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env.local"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*.env.playwright"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*.env.example"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": ".env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*secrets.sh"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*opencode.env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*opencode/secrets/*"
    },
    {
      "action": "read",
      "effect": "ask",
      "resource": "*opencode/service.json"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "rm *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rm ./*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rm /Users/afifsohaili/Tiga/*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rm /Users/afifsohaili/Projects/*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "omarchy"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "omarchy *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "hyprctl *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "systemctl --user"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "systemctl --user *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*service.json*"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "sudo *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "pkexec *"
    }
  ],
  "plugins": [],
  "references": {
    "dotfiles": {
      "description": "Use for personal shell, editor, and tool configuration conventions",
      "path": "~/Projects/dotfiles"
    },
    "mise": {
      "description": "Use for mise tool version config and task definitions",
      "path": "~/.config/mise"
    },
    "projects": {
      "description": "Use for personal projects in ~/Projects",
      "path": "~/Projects"
    }
  },
  "websearch": false
}