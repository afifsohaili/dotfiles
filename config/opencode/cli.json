{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "keybinds": {
    "session.half.page.down": "ctrl+f",
    "session.half.page.up": "ctrl+b",
    "session.messages_last_user": "<leader>6",
    "session.first": "<leader>1",
    "session.last": "<leader>9",
    "session.pin.toggle": "none",
    "session.background": "ctrl+g",
    "session.quick_switch.1": "none",
    "session.quick_switch.6": "none",
    "session.quick_switch.9": "none",
    "session.tab.select.1": "ctrl+1",
    "session.tab.select.6": "ctrl+6",
    "session.tab.select.9": "ctrl+9"
  },
  "scroll": {
    "speed": 4
  },
  "session": {
    "tps": true,
    "image_preview": true,
    "permissions": "prompt",
    "thinking": "hide"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "plugins": [
    "./plugins/ntfy",
    "./herdr-opencode"
  ],
  "tabs": {
    "layout": "horizontal",
    "mode": "off"
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "prompt": {
    "editor": false,
    "image_preview": true
  }
}
