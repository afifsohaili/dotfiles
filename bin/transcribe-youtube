#!/bin/bash
set -euo pipefail

# Transcribe YouTube videos to text using whisper.cpp (Metal GPU, large-v3)
# Usage: transcribe-youtube <url> [output-file]
#        transcribe-youtube <url> -        (prints to stdout)

URL="${1:?Usage: transcribe-youtube <youtube-url> [output-file]}"
OUTPUT="${2:-}"
MODEL="${WHISPER_MODEL:-$HOME/.cache/whisper/models/ggml-large-v3.bin}"
LANGUAGE="${WHISPER_LANG:-auto}"

# Verify tools exist
for cmd in yt-dlp ffmpeg whisper-cli; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "Error: $cmd not found in PATH" >&2
    exit 1
  fi
done

# Verify model exists
if [[ ! -f "$MODEL" ]]; then
  echo "Error: model not found at $MODEL" >&2
  echo "Set WHISPER_MODEL env var or download the model." >&2
  exit 1
fi

# Create temp directory
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

cd "$TMPDIR"

echo "→ Downloading audio..." >&2
yt-dlp -x --audio-format wav -o "audio.%(ext)s" "$URL" >&2

echo "→ Converting to 16kHz mono..." >&2
ffmpeg -y -i audio.wav -ar 16000 -ac 1 -c:a pcm_s16le audio_16k.wav >&2

echo "→ Transcribing with whisper.cpp..." >&2
whisper-cli \
  -m "$MODEL" \
  -f audio_16k.wav \
  -l "$LANGUAGE" \
  -otxt -of transcript >&2

if [[ "$OUTPUT" == "-" || -z "$OUTPUT" ]]; then
  cat transcript.txt
else
  cp transcript.txt "$OUTPUT"
  echo "→ Saved to: $OUTPUT" >&2
fi
