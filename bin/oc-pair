#!/bin/bash

# Mint a one-time opencode pairing link on the shared server (15001) and print
# it with a scannable QR.
#
# `opencode pair` cannot do this: it always pairs the background service (a
# different server on a random loopback port), so its links point at
# 127.0.0.1 and carry a code the shared server rejects. This talks to the
# shared server directly. Works on Linux (systemd unit) and macOS (the `oc`
# shell function starts the 15001 server on demand).
#
# Usage: oc-pair [--no-qr] [host]
#
# The link is single-use and expires in 5 minutes; the key it hands the app
# lasts about 30 days. `host` overrides the tailnet hostname in the link
# (default: this machine's full MagicDNS name; the short form is also shown).

set -euo pipefail

PORT=${OC_PAIR_PORT:-15001}
OPENCODE_ENV_FILE=${OPENCODE_ENV_FILE:-"$HOME/Projects/dotfiles/shell/shared/opencode.env"}

usage() {
  cat <<'EOF'
Usage: oc-pair [--no-qr] [host]

Mints a one-time pairing link on the shared opencode server (127.0.0.1:15001)
and prints it with a scannable QR. The link works once and expires in 5
minutes; the key the app receives lasts about 30 days.

  --no-qr   print only the links, no QR
  host      tailnet hostname to put in the link (default: this machine's full
            MagicDNS name, with the short form offered as a second link)
EOF
}

if [[ -r $OPENCODE_ENV_FILE ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$OPENCODE_ENV_FILE"
  set +a
fi

HOST=
QR=1
for arg in "$@"; do
  case $arg in
    -h|--help) usage; exit 0 ;;
    --no-qr) QR=0 ;;
    -*) echo "error: unknown option $arg" >&2; usage >&2; exit 2 ;;
    *) HOST=$arg ;;
  esac
done

command -v jq >/dev/null || { echo "error: jq is required" >&2; exit 1; }

if [[ -z ${OPENCODE_PASSWORD:-} ]]; then
  echo "error: OPENCODE_PASSWORD is not set (looked at $OPENCODE_ENV_FILE)" >&2
  exit 1
fi

# macOS usually has only the Tailscale app's bundled CLI, not `tailscale` on
# PATH; accept either.
tailscale_bin() {
  if command -v tailscale >/dev/null 2>&1; then
    command -v tailscale
  elif [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
    printf '%s\n' /Applications/Tailscale.app/Contents/MacOS/Tailscale
  fi
}

if [[ -z $HOST ]]; then
  TS=$(tailscale_bin)
  if [[ -z $TS ]]; then
    echo "error: Tailscale CLI not found; pass a host explicitly: oc-pair <host>" >&2
    exit 1
  fi
  FQDN=$("$TS" status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//' || true)
  if [[ -z $FQDN ]]; then
    echo "error: Tailscale is not running; pass a host explicitly: oc-pair <host>" >&2
    exit 1
  fi
  HOST=$FQDN
fi
SHORT=${HOST%%.*}

PAIR_JSON=$(curl -sS -u "opencode:${OPENCODE_PASSWORD}" -X POST "http://127.0.0.1:${PORT}/api/pair" || true)
CODE=$(jq -r '.code // empty' <<<"$PAIR_JSON" 2>/dev/null)
EXPIRES=$(jq -r '.expires_in // 300' <<<"$PAIR_JSON" 2>/dev/null)
if [[ -z $CODE ]]; then
  echo "error: no pairing code from 127.0.0.1:$PORT: ${PAIR_JSON:-connection failed}" >&2
  echo "hint: start the shared server with oc, and check that OPENCODE_PASSWORD matches it" >&2
  exit 1
fi

FULL_URL="http://${HOST}:${PORT}"
SHORT_URL="http://${SHORT}:${PORT}"

printf '\n  Open a link to connect. Links work once and expire in %d minutes.\n\n' "$((EXPIRES / 60))"
printf '    %s/auth/connect/%s\n' "$FULL_URL" "$CODE"
if [[ $SHORT != "$HOST" ]]; then
  printf '    %s/auth/connect/%s\n' "$SHORT_URL" "$CODE"
fi
printf "\n  Scan the QR on the phone, or paste a link into the app's server URL field.\n"

if ((QR)); then
  if command -v qrencode >/dev/null; then
    payload=$(jq -nc --arg code "$CODE" --arg full "$FULL_URL" --arg short "$SHORT_URL" \
      '{code: $code, urls: (if $full == $short then [$full] else [$full, $short] end)}')
    printf '\n'
    qrencode -t ANSIUTF8 -m 2 "$payload"
    printf '\n'
  else
    echo "note: qrencode not installed; run with --no-qr to silence this" >&2
  fi
fi
