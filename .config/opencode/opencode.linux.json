{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/usr/share/omarchy/*": "allow",
      "~/.local/share/omarchy/*": "allow",
      "~/.config/systemd/user/*": "allow"
    },
    "bash": {
      "omarchy": "allow",
      "omarchy *": "allow",
      "hyprctl *": "allow",
      "systemctl --user": "allow",
      "systemctl --user *": "allow",
      "sudo *": "ask",
      "pkexec *": "ask"
    }
  },
  "mcp": {
    "pencil": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/pen-mcp",
        "--app",
        "desktop",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true
    }
  }
}
