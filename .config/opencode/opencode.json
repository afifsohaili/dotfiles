{
  "permission": {
    "bash": {
      "rm *": "ask",
      "rm ./*": "allow"
    },
    "question": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/*": "allow",
      "~/.config/mise": "allow",
      "~/.config/mise/*": "allow",
      "~/.config/herdr": "allow",
      "~/.config/herdr/*": "allow",
      "~/.config/omarchy": "allow",
      "~/.config/omarchy/*": "allow",
      "~/.config/hypr": "allow",
      "~/.config/hypr/*": "allow",
      "~/.config/alacritty": "allow",
      "~/.config/alacritty/*": "allow",
      "~/.config/foot": "allow",
      "~/.config/foot/*": "allow",
      "~/.config/kitty": "allow",
      "~/.config/kitty/*": "allow",
      "~/.config/ghostty": "allow",
      "~/.config/ghostty/*": "allow",
      "~/.opencode/*": "allow",
      "~/Tiga/*": "allow",
      "~/Projects": "allow",
      "~/Projects/*": "allow",
      "~/Work": "allow",
      "~/Work/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.local": "deny",
      "*.env.playwright": "allow",
      "*.env.example": "allow",
      ".env": "deny"
    }
  },
  "plugin": [
    "./plugin/notify.ts",
    "./plugin/rm-guard.ts",
    "opencode-history-search",
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-tasks"
  ],
  "references": {
    "projects": {
      "path": "~/Projects",
      "description": "Use for personal projects in ~/Projects"
    },
    "dotfiles": {
      "path": "~/Projects/dotfiles",
      "description": "Use for personal shell, editor, and tool configuration conventions"
    },
    "mise": {
      "path": "~/.config/mise",
      "description": "Use for mise tool version config and task definitions"
    }
  },
  "default_agent": "ollama-dsv4f",
  "agent": {
    "explore": {
      "mode": "subagent",
      "model": "ollama-cloud/deepseek-v4.1-flash"
    }
  },
  "mcp": {
    "websearch": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "{env:HOME}/.config/opencode/mcp/ollama/web-search-mcp.py"
      ],
      "environment": {
        "OLLAMA_API_KEY": "{file:~/.local/share/opencode/secrets/ollama_api_key}"
      },
      "enabled": true,
      "timeout": 120000
    }
  },
  "provider": {
    "clinepass": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ClinePass",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "id": "cline-pass/glm-5.2",
          "name": "GLM-5.2 (ClinePass)",
          "reasoning": true,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 200000,
            "output": 131072
          },
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.26,
            "cache_write": 0
          }
        },
        "kimi-k2.7-code": {
          "id": "cline-pass/kimi-k2.7-code",
          "name": "Kimi K2.7 Code (ClinePass)",
